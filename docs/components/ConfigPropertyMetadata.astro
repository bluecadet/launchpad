---
import type { ConfigReferenceRow } from "../lib/config-reference.js";

interface Props {
	row: ConfigReferenceRow;
}

const { row } = Astro.props;
---

<p><strong>Input type:</strong> <code>{row.type}</code></p>
<p><strong>Required:</strong> {row.required ? "Yes" : "No"}</p>
<p><strong>Input default:</strong> {row.defaultValue === undefined ? "—" : <code>{row.defaultValue}</code>}</p>

<style>
	p {
		margin: 0.375rem 0;
	}
	code {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
</style>
