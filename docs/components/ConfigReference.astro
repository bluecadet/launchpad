---
import { getConfigReferenceRows } from "../lib/config-reference.js";
import { configReferences } from "../lib/config-references.js";

interface Props {
	id: string;
}

const { id } = Astro.props;
const reference = configReferences.find((entry) => entry.id === id);
if (!reference) throw new Error(`Unknown configuration reference: ${id}`);
const rows = getConfigReferenceRows(reference.schema, { nested: reference.nested });
---

<dl class="config-reference">
	{rows.map((row) => (
		<div class="property">
			<dt><code>{row.name}</code></dt>
			<dd>
				<p><strong>Input type:</strong> <code>{row.type}</code></p>
				<p><strong>Required:</strong> {row.required ? "Yes" : "No"}</p>
				<p><strong>Input default:</strong> {row.defaultValue === undefined ? "—" : <code>{row.defaultValue}</code>}</p>
				<p class="description">{row.description}</p>
			</dd>
		</div>
	))}
</dl>

<style>
	dl {
		margin-block: 1.5rem;
		overflow-wrap: anywhere;
	}
	.property + .property {
		margin-block-start: 2rem;
	}
	dt {
		margin-block-end: 0.75rem;
	}
	dt code {
		font-size: 1rem;
		font-weight: 600;
	}
	dd {
		margin: 0;
	}
	dd p {
		margin: 0.375rem 0;
	}
	dd .description {
		margin-block-start: 0.75rem;
		white-space: pre-wrap;
	}
	code {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
</style>
