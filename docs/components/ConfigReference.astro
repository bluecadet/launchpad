---
import { getConfigReferenceRows } from "../lib/config-reference.js";
import { configReferences } from "../lib/config-references.js";

interface Props {
	id: string;
}

const { id } = Astro.props;
const reference = configReferences.find((entry) => entry.id === id);
if (!reference) throw new Error(`Unknown configuration reference: ${id}`);
const rows = getConfigReferenceRows(reference.schema, { nested: reference.nested });
---

<div class="table-wrap">
	<table>
		<thead>
			<tr>
				<th>Option</th>
				<th>Input type</th>
				<th>Required</th>
				<th>Input default</th>
				<th>Description</th>
			</tr>
		</thead>
		<tbody>
			{rows.map((row) => (
				<tr>
					<td data-label="Option"><code>{row.name}</code></td>
					<td data-label="Input type"><code>{row.type}</code></td>
					<td data-label="Required">{row.required ? "Yes" : "No"}</td>
					<td data-label="Input default">{row.defaultValue === undefined ? "—" : <code>{row.defaultValue}</code>}</td>
					<td data-label="Description">{row.description}</td>
				</tr>
			))}
		</tbody>
	</table>
</div>

<style>
	td {
		white-space: pre-wrap;
	}
	code {
		white-space: pre-wrap;
	}
</style>
