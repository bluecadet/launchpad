---
import { getConfigReferenceRows, selectConfigReferenceRows } from "../lib/config-reference.js";
import { configReferences } from "../lib/config-references.js";
import ConfigPropertyMetadata from "./ConfigPropertyMetadata.astro";

interface Props {
	id: string;
	property?: string;
	includeChildren?: boolean;
	exclude?: readonly string[];
}

const { id, property, includeChildren, exclude } = Astro.props;
const reference = configReferences.find((entry) => entry.id === id);
if (!reference) throw new Error(`Unknown configuration reference: ${id}`);
const rows = selectConfigReferenceRows(
	getConfigReferenceRows(reference.schema, { nested: reference.nested }),
	{ property, includeChildren, exclude },
);
const selected = property === undefined ? undefined : rows[0];
const definitions = property === undefined ? rows : rows.slice(1);
---

<div class="config-reference">
	{selected && <div class="selected"><ConfigPropertyMetadata row={selected} compact /></div>}
	{definitions.length > 0 && (
		<dl>
			{definitions.map((row) => (
				<div class="property">
					<dt><code>{row.name}</code></dt>
					<dd>
						<ConfigPropertyMetadata row={row} />
						<p class="description">{row.description}</p>
					</dd>
				</div>
			))}
		</dl>
	)}
</div>

<style>
	.config-reference {
		margin-block: 1.5rem;
		overflow-wrap: anywhere;
	}
	dl {
		margin: 0;
	}
	.selected + dl,
	.property + .property {
		margin-block-start: 2rem;
	}
	dt {
		margin-block-end: 0.75rem;
	}
	dt code {
		font-size: 1rem;
		font-weight: 600;
	}
	dd {
		margin: 0;
	}
	.description {
		margin: 0.75rem 0 0.375rem;
		white-space: pre-wrap;
	}
	code {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
</style>
