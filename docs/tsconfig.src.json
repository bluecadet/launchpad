{
	"extends": "@bluecadet/launchpad-tsconfig/base.json",
	"compilerOptions": {
		"composite": true,
		// The docs site builds to ./dist, and Astro clears that directory on every build, so
		// tsc's output has to live somewhere else. Astro components and MDX are
		// compiled by the docs build; shared data modules are typechecked here.
		"rootDir": ".",
		"outDir": "./.tsbuild",
		"tsBuildInfoFile": "./.tsbuild/tsconfig.src.tsbuildinfo"
	},
	"include": ["lib/**/*.ts"],
	"references": [
		{ "path": "../packages/cli/tsconfig.src.json" },
		{ "path": "../packages/content/tsconfig.src.json" },
		{ "path": "../packages/controller/tsconfig.src.json" },
		{ "path": "../packages/monitor/tsconfig.src.json" },
		{ "path": "../packages/observability/tsconfig.src.json" },
		{ "path": "../packages/scheduler/tsconfig.src.json" }
	]
}
