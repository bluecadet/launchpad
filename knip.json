{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": [
    "-lintignore"
  ],
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@emnapi/core", "@emnapi/runtime"]
    },
    "docs": {
      "entry": [
        "recipes/*-examples/*.ts"
      ]
    },
    "packages/content": {
      "ignoreDependencies": ["@portabletext/markdown", "@types/http-cache-semantics"]
    },
    "packages/cli": {},
    "packages/monitor": {
      "ignoreBinaries": ["zig"]
    }
  }
}
