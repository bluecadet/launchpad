{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": [
    "-lintignore"
  ],
  "compilers": {
    "mdx": true
  },
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@emnapi/core", "@emnapi/runtime"]
    },
    "docs": {
      "entry": [
        "recipes/*-examples/*.ts",
        "**/*.mdx",
        "components/**/*.astro"
      ],
      "paths": {
        "@docs-src/*": ["./*"]
      }
    },
    "packages/content": {
      "ignoreDependencies": ["@portabletext/markdown", "@types/http-cache-semantics"]
    },
    "packages/cli": {},
    "packages/monitor": {
      "ignoreBinaries": ["zig"]
    }
  }
}
