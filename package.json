{
  "name": "launchpad",
  "private": true,
  "version": "0.0.1",
  "description": "monorepo for @bluecadet/launchpad and friends",
  "scripts": {
    "changeset": "changeset",
    "check": "npm run lint && npm run sherif && npm run knip && npm run docs:build && npm run typecheck && npm run test -- --run",
    "lint": "npx @biomejs/biome check",
    "lint:fix": "npx @biomejs/biome check --fix",
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "dev": "tsc --build --watch",
    "docs:build": "npm run build -w @bluecadet/launchpad-docs",
    "release": "npm run build && changeset publish",
    "test": "vitest",
    "knip": "knip",
    "sherif": "sherif -i \"@bluecadet/launchpad*\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluecadet/launchpad.git"
  },
  "contributors": [],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bluecadet/launchpad/issues"
  },
  "homepage": "https://github.com/bluecadet/launchpad#readme",
  "workspaces": [
    "./packages/*",
    "./docs"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@changesets/cli": "^3.0.3",
    "@changesets/get-github-info": "1.0.1",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@types/node": "^26.6.5",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "sherif": "^1.11.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^24 || >=26"
  },
  "packageManager": "npm@11.12.0"
}
