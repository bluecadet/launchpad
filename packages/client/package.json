{
  "name": "@bluecadet/launchpad-client",
  "version": "0.0.0",
  "description": "Typed client SDK for the @bluecadet/launchpad HTTP/SSE surface — commands, events, state mirroring, and sessions",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "engines": {
    "node": ">=23"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluecadet/launchpad.git"
  },
  "author": "Bluecadet",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bluecadet/launchpad/issues"
  },
  "homepage": "https://github.com/bluecadet/launchpad/packages/client",
  "dependencies": {
    "@bluecadet/launchpad-session": "0.0.0",
    "@bluecadet/launchpad-utils": "~3.2.0",
    "immer": "^11.1.4",
    "neverthrow": "^8.2.0"
  },
  "devDependencies": {
    "@bluecadet/launchpad-controller": "3.2.0",
    "@bluecadet/launchpad-testing": "0.1.0",
    "@bluecadet/launchpad-tsconfig": "0.1.0",
    "vitest": "^4.1.2"
  }
}
