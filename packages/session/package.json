{
  "name": "@bluecadet/launchpad-session",
  "version": "0.0.0",
  "description": "Visitor sessions for @bluecadet/launchpad — the Station session broker plugin, the VendorClient adapter contract, and its fake",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./launchpad-session": {
      "types": "./dist/launchpad-session.d.ts",
      "default": "./dist/launchpad-session.js"
    },
    "./config": {
      "types": "./dist/session-config.d.ts",
      "default": "./dist/session-config.js"
    },
    "./vendors/fake": {
      "types": "./dist/vendors/fake.d.ts",
      "default": "./dist/vendors/fake.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "engines": {
    "node": ">=23"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluecadet/launchpad.git"
  },
  "author": "Bluecadet",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bluecadet/launchpad/issues"
  },
  "homepage": "https://github.com/bluecadet/launchpad/packages/session",
  "dependencies": {
    "@bluecadet/launchpad-utils": "~3.2.0",
    "neverthrow": "^8.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bluecadet/launchpad-testing": "0.1.0",
    "@bluecadet/launchpad-tsconfig": "0.1.0",
    "vitest": "^4.1.2"
  }
}
